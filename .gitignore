.pio/
.vscode/
__pycache__/
*.pyc
.venv/
data/*
!data/.gitkeep
*.csv
!firmware/partitions_cardiag_8mb.csv
*.log
secrets.h
# Provisioning input for `:cred` (tools/serial_capture.py --send-file) and
# the hub CA: device-specific, never committed.
provision*.txt
!provision.example.txt
*.pem
.env

# Raw device dumps carry the provisioned Wi-Fi/AP passwords and hub token.
# They live outside the repo: docs/bench-dumps.md.
analysis/**/*.bin
analysis/**/*.elf
*flash*.bin
*coredump*.bin
*coredump*.elf

# Generated by pioarduino's hybrid compile (custom_sdkconfig, heapdebug envs).
firmware/managed_components/
firmware/.dummy/
firmware/sdkconfig.defaults
firmware/sdkconfig.esp32-*

# Vendor design files are not redistributed: this repo is PUBLIC and the
# Autosport Labs template carries no licence granting redistribution.
# See hardware/README.md for the official download.
hardware/vendor-*
# byte-identical copy of the vendor original (verified by md5 2026-09-22)
hardware/bolton_template.sch
