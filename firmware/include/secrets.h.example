#pragma once

// Copy this file to secrets.h and put your real values in it. secrets.h is
// gitignored; this example is not.
//
// The build works without secrets.h -- config.h falls back to defaults -- so a
// fresh clone compiles and runs. Every default below is deliberately obvious:
// it should look wrong in a packet capture if it was never changed.
//
// THIS REPO IS PUBLIC. A credential committed here outlives the commit that
// removed it, so nothing real goes in this file.

// The board's own AP, served whenever the hub network is not reachable.
// WPA2 needs 8+ characters. An open AP would let anyone in range read the
// car's bus, so it is never open.
#define WIFI_AP_PASS "changeme123"

// --- hub integration (protocol v1) ---

// The hub's Wi-Fi network. STA is tried first; on failure the board falls back
// to its own AP and behaves exactly as it did before the hub existed.
// NOTE: the ESP32-S3 is 2.4 GHz ONLY. A 5 GHz hub AP is invisible to it and
// the join just times out.
#define WIFI_STA_SSID "carhub"
#define WIFI_STA_PASS "carhub-default"

// Shared token for the mutating endpoints: POST /api/v1/time and
// POST /api/v1/files/ack. Must be byte-identical to HUB_API_TOKEN in the hub's
// secrets.env, or every POST comes back 401.
#define HUB_API_TOKEN "change-me"
