#pragma once

// Copy this file to secrets.h and put your real values in it. secrets.h is
// gitignored; this example is not. THE BUILD DOES NOT NEED secrets.h.
//
// THIS REPO IS PUBLIC. A credential committed here outlives the commit that
// removed it, so nothing real goes in this file.

// The board's own AP, served whenever the hub network is not reachable.
// WPA2 needs 8+ characters. An open AP would let anyone in range read the
// car's bus, so it is never open. Without secrets.h, config.h's public
// default is used -- set this for any board that leaves the bench.
#define WIFI_AP_PASS "changeme123"

// --- LEGACY: hub link credentials -------------------------------------------
//
// The hub's Wi-Fi, the API token, and the MQTT/CA credentials now live in NVS,
// provisioned over serial with `:cred ...` (see firmware/include/creds.h and
// docs/provisioning.md). The three values below are read ONLY by the one-time
// `:cred import`, which copies them into an EMPTY NVS store and then refuses
// to run again. Placeholder values like these are skipped by the import.
//
// After importing, delete them (or the whole file) and rebuild.
#define WIFI_STA_SSID "carhub"
#define WIFI_STA_PASS "carhub-default"
#define HUB_API_TOKEN "change-me"
